# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional model overrides
# CLAUDE_MODEL = "claude-opus-5-5"          # general advice, self-assessment
# CLAUDE_MODEL_RESEARCH = "claude-opus-5-5" # research and burden estimate

# Storage: "local" (default, for development) or "gdrive"
STORAGE_BACKEND = "local"

# Google Drive (required when STORAGE_BACKEND = "gdrive")
# DRIVE_ROOT_FOLDER_ID = "1AbC..."
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "ia-navigator@your-project.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"

# Sign-in with Google (st.login) — required for multi-user deployments
# Optional: only these email domains may use the app (comma-separated)
# ALLOWED_EMAIL_DOMAINS = "gov.au"
# [auth]
# redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
# cookie_secret = "a-long-random-string"
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
